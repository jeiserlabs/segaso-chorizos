# Segaso Chorizos — Plantilla de variables de entorno
# Copiar como .env y completar valores reales

# Secret JWT para firma de tokens del Back Office (OBLIGATORIO)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_SECRET_REAL_32_BYTES_HEX

# Contraseña inicial del admin Harold (cambiar en primer login desde el panel)
ADMIN_SEED_PASSWORD=CAMBIAR_EN_PRIMER_LOGIN

# Puerto del servidor (opcional, default: 3000)
PORT=3000

{
  "name": "segaso-app",
  "version": "1.0.0",
  "description": "Plataforma de comercio electrónico y gestión administrativa para Segaso Chorizos (Envigado)",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeiserlabs/segaso-chorizos.git"
  },
  "author": "Jeiser Gutiérrez / Segaso Chorizos",
  "license": "UNLICENSED",
  "main": "server.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --test tests/segaso_domain.test.ts",
    "test:e2e": "node --env-file=.env tests/e2e_segaso_playwright.js",
    "start": "node --env-file=.env server.js",
    "dev": "node --env-file=.env --watch server.js",
    "social:manifest": "node scripts/social_manifest.js",
    "media:products": "node scripts/build_product_photos.js",
    "media:web": "node scripts/build_web_media.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
